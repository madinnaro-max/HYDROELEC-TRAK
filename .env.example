# Variables de COMPILATION de l'appli (préfixe VITE_). Copiez en « .env.local » pour le développement.
# Pour GitHub Actions : dépôt → Settings → Secrets and variables → Actions → onglet « Variables ».

# Adresse du serveur central (HTTPS). Laissez vide si le même serveur publie l'appli web.
# Elle reste modifiable dans l'appli (écran de connexion → « Paramètres du serveur »).
VITE_API_URL=https://hydroelec.mon-domaine.ma

# Passez à true UNIQUEMENT si android/app/google-services.json (Firebase) est présent, sinon l'appli Android plante à l'enregistrement push.
VITE_ENABLE_NATIVE_PUSH=false

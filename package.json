{
  "name": "hydroelec-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HydroElec Track — gestion digitale des dossiers de raccordement Eau & Électricité (PWA + Android + iOS, offline-first).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "server": "npm --prefix server start",
    "server:install": "npm --prefix server install --ignore-scripts",
    "cap:add:android": "cap add android && node scripts/patch-native.mjs android",
    "cap:add:ios": "cap add ios && node scripts/patch-native.mjs ios",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "icons": "npx @capacitor/assets generate --android --ios --assetPath assets --iconBackgroundColor #0066FF --splashBackgroundColor #FFFFFF"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0"
  }
}
